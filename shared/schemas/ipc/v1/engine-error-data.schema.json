{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:video-translator:ipc:v1:engine-error-data",
  "title": "Video Translator IPC v1 engine error data",
  "type": "object",
  "required": ["engineCode", "safeDetails"],
  "properties": {
    "engineCode": {
      "enum": [
        "engine.parse_error",
        "engine.invalid_request",
        "engine.method_not_found",
        "engine.invalid_params",
        "engine.internal_error"
      ]
    },
    "safeDetails": {
      "type": "object",
      "required": ["reason", "retryable"],
      "properties": {
        "reason": {
          "enum": [
            "malformed_json",
            "invalid_envelope",
            "unsupported_protocol_version",
            "unsupported_method",
            "invalid_parameters",
            "unexpected_failure"
          ]
        },
        "retryable": { "type": "boolean" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
